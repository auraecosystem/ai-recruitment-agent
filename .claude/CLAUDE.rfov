### src/services/api.js

```javascript
const API_URL = "http://localhost:3000/api";

export async function uploadResume(formData) {

  const response = await fetch(
    `${API_URL}/candidates/upload`,
    {
      method: "POST",
      body: formData
    }
  );

  return response.json();
}

export async function getCandidates() {

  const response = await fetch(
    `${API_URL}/candidates`
  );

  return response.json();
}
```

